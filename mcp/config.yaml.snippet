# Optional Hermes MCP config snippet.
# Paste under ~/.hermes/config.yaml.
#
# This exposes the memory root as a filesystem MCP server.
# It is optional: scripts also work through Hermes terminal tools.
# Replace {MEMORY_ROOT} with an absolute path:
#   Windows: C:\Users\you\Hermes_Memory
#   macOS:   /Users/you/Hermes_Memory
#   Linux:   /home/you/Hermes_Memory

mcp_servers:
  hermes_memory_filesystem:
    command: "npx"
    args:
      - "-y"
      - "@modelcontextprotocol/server-filesystem"
      - "{MEMORY_ROOT}"
    enabled: true
    timeout: 30
    connect_timeout: 10
    supports_parallel_tool_calls: false

